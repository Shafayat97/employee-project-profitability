d_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="raw_projects" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="91"/><column index="2" value="120"/><column index="3" value="109"/><column index="4" value="189"/><column index="5" value="125"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="raw_timesheets" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="114"/><column index="2" value="95"/><column index="3" value="111"/><column index="4" value="132"/><column index="5" value="91"/><column index="6" value="78"/><column index="7" value="124"/><column index="8" value="133"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- 02_analysis.sql
-- Q1: Project profit (3 months: Jul-Sep 2026)
WITH revenue AS (SELECT project_id, project_name, monthly_revenue_usd*3 AS revenue FROM raw_projects),
labor AS (SELECT t.project_id, SUM(t.hours_worked) AS hours, SUM(t.hours_worked*e.hourly_rate) AS labor_cost
          FROM raw_timesheets t JOIN employees e ON t.employee_id=e.employee_id GROUP BY t.project_id),
exp AS (SELECT project_id, SUM(amount_usd) AS other_cost FROM expenses GROUP BY project_id)
SELECT r.project_name, r.revenue, l.hours, ROUND(l.labor_cost,2) AS labor_cost, x.other_cost,
       ROUND(r.revenue-l.labor_cost-x.other_cost,2) AS profit,
       ROUND(100.0*(r.revenue-l.labor_cost-x.other_cost)/r.revenue,1) AS margin_pct
FROM revenue r LEFT JOIN labor l ON r.project_id=l.project_id LEFT JOIN exp x ON r.project_id=x.project_id
ORDER BY profit DESC;

-- Q2: Employee utilization per month (160 hours = 100%)
SELECT e.employee_name, SUBSTR(t.work_date,1,7) AS month, SUM(t.hours_worked) AS hours,
       ROUND(100.0*SUM(t.hours_worked)/160,1) AS utilization_pct
FROM timesheets t JOIN employees e ON t.employee_id=e.employee_id
GROUP BY e.employee_name, month ORDER BY utilization_pct DESC;</sql><current_tab id="0"/></tab_sql></sqlb_project>
